# URL da orbita-api. Em dev local, o padrão em src/lib/api.ts já aponta para
# http://localhost:3000 — só precisa deste .env para apontar para o backend do Railway.
VITE_API_URL=http://localhost:3000

# Public key (pk_...) do Pagar.me — usada só para tokenizar cartão direto no navegador.
# Segura de expor no bundle: é a chave pública, não a secreta. Ver docs/assinatura.md.
VITE_PAGARME_PUBLIC_KEY=
